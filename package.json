{
  "name": "exactly-once-webhooks",
  "version": "0.10.1",
  "description": "Process a payment webhook once, even when copies race. On Postgres the write and its \"done\" record commit in one transaction; on Redis it is a lease that flags overruns. TypeScript, no runtime deps.",
  "homepage": "https://github.com/joshuavivo/exactly-once-webhooks#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joshuavivo/exactly-once-webhooks.git"
  },
  "bugs": {
    "url": "https://github.com/joshuavivo/exactly-once-webhooks/issues"
  },
  "author": "Joshua Vivo (https://shadowvivo.com)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "schema.sql",
    "README.md",
    "DESIGN.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "bench": "node bench/bench.ts"
  },
  "keywords": [
    "webhook",
    "idempotency",
    "exactly-once",
    "payments",
    "stripe",
    "postgres"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "fast-check": "^4.11.0",
    "pg": "^8.23.1",
    "redis": "^6.4.0",
    "typescript": "^7.0.2"
  }
}
