{
  "name": "exactly-once-webhooks",
  "version": "0.7.0",
  "description": "Process payment webhooks exactly once, even when they are delivered twice or arrive at the same moment. In-memory, Postgres and Redis stores.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "schema.sql",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "bench": "node bench/bench.ts"
  },
  "keywords": [
    "webhook",
    "idempotency",
    "exactly-once",
    "payments",
    "stripe",
    "postgres"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "redis": "^6.3.1",
    "typescript": "^7.0.2"
  }
}
